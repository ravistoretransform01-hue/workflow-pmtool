{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://outskillmarketing.com/wp-json/wp-platform/v1/:path*"
    },
    {
      "source": "/wp-json/wp-platform/v1/:path*",
      "destination": "https://www.workflowpm.com/wp-json/wp-platform/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}